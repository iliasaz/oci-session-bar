<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>OCI Session Bar</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Ilia Sazonov. MIT License.</string>
	<!-- The single key that makes this a menu-bar-only app: no Dock icon, no
	     Cmd-Tab entry. Consequence: there is no Dock menu, so the Quit menu
	     item is the only way out and must always be present. -->
	<key>LSUIElement</key>
	<true/>
	<!-- `releases/latest/download/` rather than a fixed tag: the release workflow
	     attaches appcast.xml to every release, and this path always redirects to
	     the newest one. -->
	<key>SUFeedURL</key>
	<string>https://github.com/iliasaz/oci-session-bar/releases/latest/download/appcast.xml</string>
	<!-- The public half of the EdDSA key whose private half is the repository's
	     SPARKLE_PRIVATE_KEY secret; the release workflow signs each enclosure
	     with that key and Sparkle checks the signature against this one. A
	     mismatch is only a warning to `generate_appcast`, which then emits an
	     unsigned enclosure — release.yml fails the build on that rather than
	     shipping a feed no installed copy will accept. -->
	<key>SUPublicEDKey</key>
	<string>UZrMarqLus6f7ISHSiFg1UnBVbT806XkVapBsu+XmRE=</string>
	<!-- Left unset, Sparkle asks permission to check automatically on the second
	     launch. This app is LSUIElement, so that alert would arrive with nothing
	     on screen to have prompted it. YES turns checking on without asking; the
	     Settings toggle overrides it through SPUUpdater afterwards. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
</dict>
</plist>
